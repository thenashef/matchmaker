<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.matchmaker.admin.presentation.LiveSessionMonitorController">
    <top>
        <VBox spacing="4">
            <BorderPane.margin><Insets top="10" right="10" bottom="10" left="10"/></BorderPane.margin>
            <Label fx:id="titleLabel" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
            <Label fx:id="detailLabel" style="-fx-font-size: 13px;"/>
        </VBox>
    </top>
    <center>
        <GridPane fx:id="boardGrid" alignment="CENTER" prefWidth="400.0" prefHeight="400.0">
            <BorderPane.margin><Insets top="10" right="10" bottom="10" left="10"/></BorderPane.margin>
        </GridPane>
    </center>
    <bottom>
        <HBox spacing="10" alignment="CENTER">
            <BorderPane.margin><Insets top="10" right="10" bottom="20" left="10"/></BorderPane.margin>
            <Button fx:id="forceEndButton" text="Force End Session" onAction="#onForceEndSession"/>
            <Button fx:id="backButton" text="Back to Dashboard" onAction="#onBackToDashboard"/>
        </HBox>
    </bottom>
</BorderPane>
