<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.matchmaker.admin.presentation.AddGameTypeController"
      spacing="10" alignment="TOP_CENTER">
    <padding><Insets top="30" right="30" bottom="30" left="30"/></padding>
    <Label text="New Game Type" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
    <TextField fx:id="nameField" promptText="Name" maxWidth="280"/>
    <TextArea fx:id="descriptionField" promptText="Description" maxWidth="280" prefRowCount="3"/>
    <HBox spacing="10" alignment="CENTER">
        <Label text="Min Players"/>
        <TextField fx:id="minPlayersField" prefWidth="60" text="2"/>
        <Label text="Max Players"/>
        <TextField fx:id="maxPlayersField" prefWidth="60" text="2"/>
    </HBox>
    <HBox spacing="10" alignment="CENTER">
        <Label text="Board Rows"/>
        <TextField fx:id="boardRowsField" prefWidth="60" text="8"/>
        <Label text="Board Cols"/>
        <TextField fx:id="boardColsField" prefWidth="60" text="8"/>
    </HBox>
    <HBox spacing="10" alignment="CENTER">
        <Button fx:id="submitButton" text="Submit" onAction="#onSubmit"/>
        <Button fx:id="cancelButton" text="Cancel" onAction="#onCancel"/>
    </HBox>
    <Label fx:id="statusLabel" textFill="#b00020" wrapText="true" maxWidth="320"/>
</VBox>
