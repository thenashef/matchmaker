<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.matchmaker.client.presentation.LobbyController"
      spacing="10" alignment="TOP_CENTER">
    <padding><Insets top="20" right="24" bottom="20" left="24"/></padding>
    <HBox alignment="CENTER_LEFT" maxWidth="Infinity">
        <Label fx:id="welcomeLabel" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="ratingLabel" style="-fx-font-size: 16px;"/>
    </HBox>
    <Label text="Choose a game" style="-fx-font-size: 14px;"/>
    <FlowPane fx:id="gameTypeTiles" hgap="16" vgap="16" alignment="CENTER"
              prefHeight="240" maxHeight="240" maxWidth="Infinity"/>
    <Label fx:id="statusLabel" textFill="#b00020" wrapText="true" maxWidth="800"/>
    <Label text="Leaderboard" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
    <TableView fx:id="leaderboardTable" VBox.vgrow="ALWAYS" maxWidth="Infinity">
        <columns>
            <TableColumn fx:id="rankColumn" text="#" prefWidth="50"/>
            <TableColumn fx:id="usernameColumn" text="Username" prefWidth="280"/>
            <TableColumn fx:id="ratingColumn" text="Rating" prefWidth="100"/>
            <TableColumn fx:id="recordColumn" text="W/L/D" prefWidth="120"/>
        </columns>
    </TableView>
</VBox>
